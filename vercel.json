{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ee-alici.de" }],
      "destination": "https://www.elektiger.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ee-alici.de" }],
      "destination": "https://www.elektiger.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "elektriger.de" }],
      "destination": "https://www.elektiger.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.elektriger.de" }],
      "destination": "https://www.elektiger.de/:path*",
      "permanent": true
    },
    {
      "source": "/profi-service",
      "destination": "/e-check",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
